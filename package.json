{
  "name": "@gravity-ui/themes",
  "version": "0.0.0",
  "private": true,
  "description": "Public Gravity UI themes, validation and pinned preview renderer",
  "main": "dist/catalog.json",
  "types": "dist/catalog.d.ts",
  "files": [
    "dist",
    "themes",
    "previews",
    "LICENSE",
    "licenses"
  ],
  "scripts": {
