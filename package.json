{
  "name": "@gravity-ui/themes",
  "version": "0.0.0",
  "description": "Public Gravity UI themes, validation and pinned preview renderer",
  "main": "dist/catalog.json",
  "types": "dist/catalog.d.ts",
  "files": [
    "dist",
    "themes",
    "LICENSE",
    "licenses"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-catalog.mjs",
    "render:build": "next build renderer",
    "render:start": "next start renderer -p 3010",
    "render:submission": "node scripts/render-submission.mjs",
    "test": "npm run build && npm run typecheck && npm run lint",
    "prepare": "npm run build",
    "lint:js": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"renderer/**/*.scss\"",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:styles && npm run lint:prettier",
    "typecheck": "tsc --noEmit && tsc --noEmit -p renderer && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@gravity-ui/uikit-themer": "^1.8.0",
    "chroma-js": "^3.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@fontsource/titillium-web": "5.3.0",
    "@fontsource/ubuntu-mono": "5.3.0",
    "@gravity-ui/eslint-config": "4.3.2",
    "@gravity-ui/icons": "2.22.0",
    "@gravity-ui/navigation": "6.3.1",
    "@gravity-ui/prettier-config": "1.1.1",
    "@gravity-ui/stylelint-config": "5.0.0",
    "@gravity-ui/uikit": "7.47.1",
    "@playwright/test": "1.57.0",
    "@svgr/webpack": "6.5.1",
    "@types/chroma-js": "2.4.4",
    "@types/node": "18.11.17",
    "@types/react": "18.3.12",
    "bem-cn-lite": "4.1.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "next": "14.2.24",
    "next-global-css": "1.3.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "1.56.1",
    "sharp": "0.34.5",
    "stylelint": "16.26.1",
    "typescript": "5.1.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/themes.git"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.json"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./normalize-imported": {
      "types": "./dist/normalize-imported.d.ts",
      "default": "./dist/normalize-imported.js"
    },
    "./draft": {
      "types": "./dist/draft.d.ts",
      "default": "./dist/draft.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    }
  }
}
