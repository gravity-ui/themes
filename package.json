    "chroma-js": "3.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@svgr/webpack": "6.5.1",
    "@types/chroma-js": "2.4.4",
    "@types/node": "18.11.17",
    "@types/react": "18.3.12",
    "sass": "1.56.1",
    "typescript": "5.1.6",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@fontsource/titillium-web": "5.3.0",
    "@fontsource/ubuntu-mono": "5.3.0",
    "@gravity-ui/icons": "2.22.0",
    "@gravity-ui/navigation": "6.3.1",
    "bem-cn-lite": "4.1.0",
    "next": "14.2.24",
    "next-global-css": "1.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.34.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gravity-ui/themes.git"
  }
